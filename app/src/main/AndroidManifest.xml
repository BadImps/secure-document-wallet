<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <package android:name="com.sec.android.gallery3d" />
    </queries>
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="My Vault"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/AppTheme">
        <activity android:name=".CardImportWizardActivity" android:exported="false" />
        <activity android:name=".PrivateMediaActivity" android:exported="false" />
        <activity android:name=".PersonalInformationActivity" android:exported="false" />
        <activity android:name=".BankCardActivity" android:exported="false" />
        <activity
            android:name=".CardFullscreenActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/AppTheme.Fullscreen" />
        <activity android:name=".EditDocumentActivity" android:exported="false" />
        <activity android:name=".CategoryActivity" android:exported="false" />
        <activity android:name=".DocumentActivity" android:exported="false" />
        <activity android:name=".VaultHealthActivity" android:exported="false" />
        <activity android:name=".VaultSearchActivity" android:exported="false" />
        <receiver android:name=".ExpiryReceiver" android:exported="false" />
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
