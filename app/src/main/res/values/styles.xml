<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#159A8C</item>
        <item name="android:navigationBarColor">#F5F7F6</item>
        <item name="android:statusBarColor">#12372F</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:alertDialogTheme">@style/VaultDialog</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
    <style name="VaultDialog" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@drawable/dialog_panel</item>
        <item name="android:colorAccent">#159A8C</item>
        <item name="android:windowMinWidthMajor">88%</item>
        <item name="android:windowMinWidthMinor">92%</item>
    </style>
    <style name="AppTheme.Fullscreen" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#159A8C</item>
        <item name="android:statusBarColor">#031426</item>
        <item name="android:navigationBarColor">#031426</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
